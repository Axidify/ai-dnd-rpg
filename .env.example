# Copy this file to .env and configure your LLM provider

# LLM Provider: gemini (default) or vllm
# If VLLM_BASE_URL is set, vLLM is used automatically unless LLM_PROVIDER=gemini
LLM_PROVIDER=gemini

# --- Google Gemini (cloud) ---
GOOGLE_API_KEY=your-google-api-key-here
# Options: gemini-2.5-pro, gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-pro

# --- vLLM (local OpenAI-compatible server) ---
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=qwen-coder
# VLLM_API_KEY=EMPTY

# --- Output token budgets (optional) ---
# Ceilings, not targets: prompts keep replies short. Thinking models spend
# part of the budget on hidden reasoning, so tight caps truncate replies.
# LLM_NARRATION_MAX_TOKENS=8192   (vLLM: uncapped unless set; must fit the model's context)
# LLM_CLASSIFIER_MAX_TOKENS=4096  (roll arbiter JSON)

# Save Directory (optional - defaults to ./saves/)
# SAVES_DIR=./saves

# --- API server ---
# API_PORT=5000
# Bind address. Keep 127.0.0.1 unless you need LAN access; the API has no auth.
# API_HOST=127.0.0.1
# Flask debug mode (never enable on a reachable host: the debugger runs code)
# DEBUG=false
# Extra origins allowed to call the API directly (the Vite dev proxy doesn't need this)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
